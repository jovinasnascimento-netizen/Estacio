#include <stdio.h>
int main() {
    float notas[8];
    float frequencia;
    int i;

    int aprovados = 0;
    int reprovados = 0;

    float maiorNota = 0;

    for (i=1; i<=8; i++){
        printf ("Insira a Nota do Aluno: ");
        scanf ("%f", &notas[i]);

        printf ("Insira a Frequência do Aluno: ");
        scanf ("%f", &frequencia);

        if (notas[i] > maiorNota){
            maiorNota = notas[i];
        }
        
        if (notas[i] <= 7 && frequencia <= 75) {
            printf ("Aluno Reprovado\n");
            reprovados++;
        }
        else if (notas[i] >=7 && frequencia >=75) {
            printf ("Aluno Aprovado\n");
            aprovados++;
        }
        else if (notas[i] >=7 && frequencia <=75) {
            printf ("Aluno Reprovado\n");
            reprovados++;
        }
        else if (notas[i] <=7 && frequencia >=75) {
            printf ("Aluno Reprovado\n");
            reprovados++;
        }
        else {
            printf ("Erro de Programa\n");
        }
    }
        printf ("Número de aprovados: %d\n", aprovados);
        printf ("Número de reprovados: %d\n", reprovados);
        printf ("Maior nota registrada: %.2f\n", maiorNota);
   
    return 0;
}
